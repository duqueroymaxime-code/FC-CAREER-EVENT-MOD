        style={{
          margin: 0,
          fontSize: 12,
          fontWeight: 900,
          textTransform: "uppercase",
          letterSpacing: 1,
        }}
      >
        {label}
      </p>

      <h3 style={{ margin: "8px 0 0", color }}>{value}</h3>
    </div>
  );
}

