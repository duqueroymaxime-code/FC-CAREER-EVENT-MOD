"use client";

import { useState } from "react";

function safeNumber(value, fallback = 0) {
  const n = Number(value);
  return Number.isFinite(n) ? n : fallback;
}

function clampScore(value) {
  const n = Number(value);
  const safe = Number.isFinite(n) ? n : 0;
  return Math.max(0, Math.min(100, Math.round(safe)));
}

function getMarketLevel(score) {
  if (score >= 80) return { label: "Tres recherche", color: "#22d3ee" };
  if (score >= 65) return { label: "Courtise", color: "#bef264" };
  if (score >= 50) return { label: "Surveillance", color: "#fbbf24" };
  return { label: "Peu suivi", color: "#94a3b8" };
}

export default function PlayerMercato({ playerCareer = {}, onUpdate = () => {} }) {
  const [localCareer, setLocalCareer] = useState(playerCareer || {});

  const career = localCareer;
  const state = career.state || {};
  const stats = career.stats || {};
  const world = career.world || {};

  const reputation = safeNumber(state.reputation, 40);
  const popularity = safeNumber(state.popularity, 35);
  const agentTrust = safeNumber(state.agentTrust, 50);
  const transferDesire = safeNumber(state.transferDesire, 0);
  const morale = safeNumber(state.morale, 70);
  const goals = safeNumber(stats.goals, 0);
  const assists = safeNumber(stats.assists, 0);

  const marketScore = clampScore(
    reputation * 0.3 +
    popularity * 0.2 +
    agentTrust * 0.2 +
    goals * 1.5 +
    assists
  );

  const level = getMarketLevel(marketScore);

  function callAgent() {
    const nextState = {
      ...state,
      agentTrust: clampScore(agentTrust + 4),
      transferDesire: clampScore(transferDesire + 2),
      morale: clampScore(morale + 1),
    };

    const nextCareer = {
      ...career,
      state: nextState,
      world: {
        ...world,
        news: [
          {
            id: Date.now(),
            title: "Appel agent",
            body: "Ton agent commence a activer son reseau.",
          },
          ...(world.news || []),
        ],
      },
    };

    setLocalCareer(nextCareer);
    onUpdate(nextCareer);
  }

  return (
    <div style={{ display: "grid", gap: 20 }}>
      <section className="panel">
        <p style={{ color: "#a78bfa", fontWeight: 900 }}>
          Mercato joueur avance
        </p>

        <h2>Radar des clubs</h2>

        <div
          className="card"
          style={{
            border: "2px solid " + level.color,
            marginTop: 12,
          }}
        >
          <h3>
            {level.label} ({marketScore}/100)
          </h3>
        </div>

        <div className="grid-4" style={{ marginTop: 12 }}>
          <div className="card">Reputation: {reputation}</div>
          <div className="card">Popularite: {popularity}</div>
          <div className="card">Agent: {agentTrust}</div>
          <div className="card">Envie depart: {transferDesire}</div>
        </div>
      </section>

      <section className="panel">
        <h2>Actions joueur</h2>

        <div className="grid-4">
          <button className="choice-btn" onClick={callAgent}>
            <b>Appeler l agent</b>
          </button>

          <button className="choice-btn">
            <b>Demander position club</b>
          </button>

          <button className="choice-btn">
            <b>Rester concentre</b>
          </button>

          <button className="choice-btn">
            <b>Afficher ambition</b>
          </button>
        </div>
      </section>

      <section className="panel">
        <h2>Stats utilisees</h2>

        <div className="grid-4">
          <div className="card">Buts: {goals}</div>
          <div className="card">Passes: {assists}</div>
        </div>
      </section>
    </div>
  );
}

