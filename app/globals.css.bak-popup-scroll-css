:root {
  --bg: #06080d;
  --panel: rgba(11, 17, 28, 0.94);
  --card: rgba(16, 22, 36, 0.94);
  --text: #ffffff;
  --muted: #94a3b8;
  --soft: #cbd5e1;
  --lime: #bef264;
  --cyan: #22d3ee;
  --violet: #c084fc;
  --amber: #fbbf24;
  --red: #fb7185;
  --border: rgba(255, 255, 255, 0.14);
  --shadow: 0 28px 90px rgba(0, 0, 0, 0.45);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: #06080d;
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

.app {
  min-height: 100vh;
  background:
    radial-gradient(circle at 15% 8%, rgba(190, 242, 100, 0.18), transparent 28%),
    radial-gradient(circle at 85% 12%, rgba(34, 211, 238, 0.15), transparent 28%),
    linear-gradient(135deg, #06080d, #0c1220 45%, #05070b);
  color: var(--text);
}

.app.light {
  --panel: rgba(255, 255, 255, 0.9);
  --card: rgba(255, 255, 255, 0.96);
  --text: #07111f;
  --muted: #475569;
  --soft: #1e293b;
  --border: rgba(15, 23, 42, 0.16);
  --shadow: 0 26px 80px rgba(15, 23, 42, 0.16);
  background:
    radial-gradient(circle at 15% 8%, rgba(132, 204, 22, 0.24), transparent 28%),
    radial-gradient(circle at 85% 12%, rgba(6, 182, 212, 0.18), transparent 28%),
    linear-gradient(135deg, #f8fafc, #e2e8f0 45%, #ffffff);
}

.bg-grid {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.045;
  background-image:
    linear-gradient(90deg, rgba(255,255,255,.8) 1px, transparent 1px),
    linear-gradient(0deg, rgba(255,255,255,.8) 1px, transparent 1px);
  background-size: 72px 72px;
}

.app.light .bg-grid {
  opacity: 0.15;
  background-image:
    linear-gradient(90deg, rgba(15,23,42,.25) 1px, transparent 1px),
    linear-gradient(0deg, rgba(15,23,42,.25) 1px, transparent 1px);
}

.shell {
  position: relative;
  max-width: 1500px;
  margin: 0 auto;
  padding: 18px;
}

.layout {
  display: grid;
  grid-template-columns: 310px minmax(0, 1fr);
  gap: 18px;
}

.panel,
.card {
  border: 1px solid var(--border);
  background: var(--panel);
  box-shadow: var(--shadow);
  border-radius: 28px;
  backdrop-filter: blur(18px);
}

.panel {
  padding: 20px;
}

.card {
  padding: 22px;
}

.card.pitch {
  background:
    radial-gradient(circle at 10% 10%, rgba(190,242,100,.18), transparent 32%),
    var(--card);
}

.card.media {
  background:
    radial-gradient(circle at 90% 10%, rgba(34,211,238,.16), transparent 35%),
    var(--card);
}

.sidebar {
  position: sticky;
  top: 18px;
  height: calc(100vh - 36px);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 42px;
  align-items: center;
  max-width: 1240px;
  margin: 0 auto;
  padding: 48px 24px;
  position: relative;
}

.hero-title {
  font-size: clamp(54px, 8vw, 110px);
  line-height: 0.9;
  margin: 24px 0;
  letter-spacing: -0.08em;
}

.gradient-text {
  background: linear-gradient(90deg, var(--lime), var(--cyan), #ffffff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-subtitle {
  color: var(--soft);
  font-size: 20px;
  line-height: 1.7;
}

.hero-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 34px;
}

.big-choice {
  border: 0;
  border-radius: 30px;
  padding: 28px;
  text-align: left;
  min-height: 180px;
  box-shadow: var(--shadow);
  transition: 0.18s;
}

.big-choice:hover {
  transform: translateY(-4px);
}

.big-choice.manager {
  background: var(--lime);
  color: #07100a;
}

.big-choice.player {
  background: var(--cyan);
  color: #061018;
}

.preview {
  border-radius: 36px;
  padding: 22px;
  background: rgba(255,255,255,.08);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.preview-inner {
  background: rgba(5, 8, 15, 0.9);
  border-radius: 28px;
  padding: 22px;
}

.app.light .preview-inner {
  background: rgba(255,255,255,.78);
}

.kicker {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  background: rgba(255,255,255,.1);
  border: 1px solid var(--border);
}

.kicker.lime {
  background: var(--lime);
  color: #07100a;
}

.kicker.cyan {
  background: var(--cyan);
  color: #061018;
}

.kicker.amber {
  background: var(--amber);
  color: #1d1202;
}

.kicker.red {
  background: var(--red);
  color: white;
}

.kicker.green {
  background: #34d399;
  color: #03130a;
}

.club-row {
  display: flex;
  gap: 14px;
  align-items: center;
}

.badge {
  width: 64px;
  height: 64px;
  border-radius: 22px;
  display: grid;
  place-items: center;
  color: white;
  font-weight: 1000;
  border: 1px solid rgba(255,255,255,.28);
  box-shadow: 0 18px 44px rgba(0,0,0,.35);
}

.badge.large {
  width: 92px;
  height: 92px;
  border-radius: 28px;
  font-size: 24px;
}

.badge.small {
  width: 46px;
  height: 46px;
  border-radius: 16px;
  font-size: 12px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: auto;
}

.nav button,
.secondary-btn {
  border: 1px solid var(--border);
  background: rgba(255,255,255,.08);
  color: var(--text);
  border-radius: 18px;
  padding: 13px 14px;
  font-weight: 900;
  text-align: left;
}

.nav button.active,
.nav button:hover,
.secondary-btn:hover {
  background: var(--lime);
  color: #07100a;
}

.primary-btn {
  border: 0;
  background: var(--lime);
  color: #07100a;
  border-radius: 20px;
  padding: 16px;
  font-weight: 1000;
}

.primary-btn:hover {
  background: white;
}

.select,
.input {
  width: 100%;
  background: rgba(0,0,0,.28);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 14px;
}

.app.light .select,
.app.light .input {
  background: rgba(255,255,255,.88);
  color: #07111f;
}

.main {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.header-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 18px;
}

.title-xl {
  font-size: clamp(36px, 5vw, 64px);
  line-height: 0.95;
  margin: 14px 0;
  letter-spacing: -0.06em;
}

.muted {
  color: var(--muted);
}

.soft {
  color: var(--soft);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.stat {
  border: 1px solid var(--border);
  background: rgba(0,0,0,.20);
  border-radius: 22px;
  padding: 16px;
}

.app.light .stat {
  background: rgba(255,255,255,.68);
}

.stat-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .22em;
  color: var(--muted);
  font-weight: 900;
}

.stat-value {
  margin-top: 8px;
  font-size: 28px;
  font-weight: 1000;
}

.lime { color: var(--lime); }
.cyan { color: var(--cyan); }
.violet { color: var(--violet); }
.amber { color: var(--amber); }
.red { color: var(--red); }

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 18px;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 18px;
}

.event-card {
  overflow: hidden;
  border-radius: 30px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  text-align: left;
  box-shadow: var(--shadow);
}

.event-strip {
  height: 8px;
}

.event-body {
  padding: 20px;
}

.modal-backdrop {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.84);
  backdrop-filter: blur(18px);
  padding: 18px;
}

.modal {
  width: min(1280px, 100%);
  max-height: 92vh;
  overflow: hidden;
  border-radius: 38px;
  border: 1px solid var(--border);
  background: #080d14;
  box-shadow: 0 40px 160px rgba(0,0,0,.75);
}

.app.light .modal {
  background: #ffffff;
}

.modal-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  max-height: 92vh;
  overflow: auto;
}

.modal-left {
  padding: 24px;
  border-right: 1px solid var(--border);
}

.modal-right {
  padding: 28px;
}

.event-image {
  width: 100%;
  height: 390px;
  object-fit: cover;
  border-radius: 28px;
  background: rgba(0,0,0,.25);
  border: 1px solid var(--border);
}

.close-btn {
  border: 1px solid var(--border);
  background: rgba(255,255,255,.1);
  color: var(--text);
  border-radius: 999px;
  width: 42px;
  height: 42px;
  font-size: 24px;
  font-weight: 900;
}

.effect-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.effect-list li {
  display: flex;
  gap: 8px;
  background: rgba(0,0,0,.22);
  border-radius: 14px;
  padding: 10px;
  margin-top: 8px;
}

.app.light .effect-list li {
  background: rgba(15,23,42,.08);
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
}

.choice-btn {
  border: 1px solid rgba(190,242,100,.3);
  background: var(--lime);
  color: #07100a;
  border-radius: 20px;
  padding: 16px;
  font-weight: 1000;
  text-align: left;
}

.club-picker {
  min-height: 100vh;
  padding: 24px;
  position: relative;
}

.club-picker-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 0;
}

.club-card {
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  border-radius: 30px;
  padding: 20px;
  text-align: left;
  box-shadow: var(--shadow);
}

.club-card.selected {
  border-color: var(--lime);
  box-shadow: 0 0 80px rgba(190,242,100,.16);
}

.fixture {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
}

@media (max-width: 1050px) {
  .layout,
  .hero,
  .header-grid,
  .modal-grid {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: relative;
    height: auto;
  }

  .grid-3,
  .grid-2,
  .stat-grid,
  .choice-grid,
  .hero-actions {
    grid-template-columns: 1fr;
  }
}