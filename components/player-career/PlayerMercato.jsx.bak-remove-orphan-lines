function getMarketLevel(score) {
  if (score >= 82) {
    return {
      label: "Approche possible",
      color: "#bef264",
      detail:
        "Ton profil peut devenir un vrai dossier mercato si ton club ouvre la porte.",
    };
  }

  if (score >= 68) {
    return {
      label: "Intérêt concret",
      color: "#22d3ee",
      detail:
        "Des clubs peuvent commencer à te suivre sérieusement si tu confirmes.",
    };
  }

  if (score >= 52) {
    return {
      label: "Surveillance active",
      color: "#a78bfa",
      detail:
        "Ton nom peut circuler chez certains recruteurs, mais rien n’est encore officiel.",
    };
  }

  if (score >= 35) {
    return {
      label: "Intérêt faible",
      color: "#fbbf24",
      detail:
        "Tu dois encore enchaîner les performances pour attirer un vrai mouvement.",
    };
  }

  return {
    label: "Peu suivi",
    color: "#94a3b8",
    detail: "Le marché ne bouge pas encore vraiment autour de toi.",
  };
}

function StatCard({ label, value, color = "white" }) {
  return (
    <div
